{
  "manifest_version": 3,
  "name": "LogicFlow Teyit",
  "version": "0.1.0",
  "description": "Açık haber sayfasını LogicFlow teyit API'siyle analiz eder.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:*/*", "http://localhost:*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LogicFlow Teyit"
  }
}
